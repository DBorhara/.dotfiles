# Directory this file really lives in (resolves the ~/.zshrc symlink)
ZSH_CFG_DIR="${${(%):-%x}:A:h}"

# ========================================
# 🧠 Environment
# ========================================
typeset -U path fpath # no duplicate entries, even after `so`

# Homebrew (static copy of `brew shellenv` — avoids spawning brew every shell)
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

path=(/opt/homebrew/opt/openjdk/bin "$HOME/.local/bin" $path)
export PATH

export EDITOR="nvim"
export EZA_CONFIG_DIR="$HOME/.config/eza"

# Catppuccin Mocha for CLI tools (matches kitty, Neovim, tmux, eza)
export BAT_THEME="Catppuccin Mocha"
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A,border:#6C7086,label:#CDD6F4"

# kitten ssh only works inside kitty
[[ "$TERM" == "xterm-kitty" ]] && alias ssh="kitty +kitten ssh"

# ========================================
# 📜 History
# ========================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# ========================================
# 🧩 Completion
# ========================================
# All fpath additions must come before compinit.
fpath=("$HOME/.docker/completions" $fpath)

autoload -Uz compinit
# Full security check + dump rebuild at most once a day; otherwise use cache.
() {
  setopt local_options extended_glob
  if [[ -n $HOME/.zcompdump(#qN.mh+24) || ! -e $HOME/.zcompdump ]]; then
    compinit -u
  else
    compinit -C -u
  fi
}

# FZF key bindings: Ctrl-R history, Ctrl-T files, Alt-C cd.
# Must load before fzf-tab, otherwise fzf takes over <Tab>.
command -v fzf >/dev/null && source <(fzf --zsh)

# fzf-tab (after compinit and fzf, before widget-wrapping plugins). Owns <Tab>.
[[ -f "$ZSH_CFG_DIR/fzf-tab/fzf-tab.plugin.zsh" ]] && source "$ZSH_CFG_DIR/fzf-tab/fzf-tab.plugin.zsh"
zstyle ':fzf-tab:*' use-fzf-default-opts yes   # use the Catppuccin colours above

# Autosuggestions
[[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ========================================
# 🔍 FZF
# ========================================
alias fzf='fzf --preview "bat --color=always --style=numbers --line-range=:500 {}"'

# ========================================
# 🐈 BAT
# ========================================
alias cat='bat'
tailbat() {
  tail -f "$1" | bat --paging=never --language=log --plain
}

# ========================================
# 🧱 Zoxide (better cd)
# ========================================
eval "$(zoxide init zsh)"
unalias cd 2>/dev/null
cd() { z "$@"; }

alias ..='cd ..'
alias ...='cd ../..'

# s: fuzzy-pick a project and open / attach its tmux session (sesh)
s() {
  local pick
  pick=$(sesh list --icons -d | fzf --ansi --no-sort --height 60% --reverse \
    --border-label ' sesh ' --prompt '⚡  ' --preview 'sesh preview {}') || return
  sesh connect "$pick"
}

# ========================================
# 🖼️ Fastfetch
# ========================================
# tmux can't pass the kitty image protocol through directly; `kitten icat`
# can (via allow-passthrough), so use it inside tmux. In that mode fastfetch
# only prints its 8 info lines and doesn't leave room for the 17-row image
# (16 + 1 top padding), so pad below it until the cursor clears the image.
if [[ -n "$TMUX" ]]; then
  _ff_row() { # current cursor row, asked from the terminal (tmux answers)
    local pos
    stty -echo < /dev/tty   # don't echo the reply (^[[9;1R) on screen
    print -n '\e[6n' > /dev/tty
    read -s -d R pos < /dev/tty
    stty echo < /dev/tty
    pos=${pos#*\[}
    print -- ${pos%%;*}
  }
  _ff_start=$(_ff_row)
  fastfetch --logo-type kitty-icat --logo-width 32 --logo-height 16 \
    --logo-preserve-aspect-ratio true
  _ff_pad=$(( _ff_start + 17 - $(_ff_row) ))
  (( _ff_pad > 0 )) && repeat $_ff_pad echo
  unset -f _ff_row; unset _ff_start _ff_pad
else
  fastfetch
fi

