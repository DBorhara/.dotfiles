# ========================================
alias cfgnvim="nvim ~/.config/nvim/"
alias leetcode="nvim leetcode.nvim"

# ========================================
# 📁 EZA
# ========================================
alias ls='eza -al --hyperlink --icons --git -G --group-directories-first --time-style=long-iso'
alias cfgeza="nvim ~/.config/eza"

# ========================================
# 🐱 kitty
# ========================================
alias cfgkitty="nvim ~/.config/kitty/kitty.conf"

# ========================================
# 🧱 TMUX
# ========================================
alias cfgtmux="nvim ~/.config/tmux"

# ========================================
# 🌲 TRE
# ========================================
tre() { command tre "$@" -e && source "/tmp/tre_aliases_$USER" 2>/dev/null; }
alias tree='tre'

# ========================================
# ⚙️ Config Shortcuts
# ========================================
alias zshrc="nvim ~/.zshrc"
alias so="source ~/.zshrc"

# Only meaningful inside iTerm2
[[ "$TERM_PROGRAM" == "iTerm.app" && -e "$HOME/.iterm2_shell_integration.zsh" ]] &&
  source "$HOME/.iterm2_shell_integration.zsh"

# ========================================
# 🌿 Git prompt
# ========================================
autoload -Uz add-zsh-hook vcs_info
add-zsh-hook precmd vcs_info

# Branch in cyan; green = staged changes, red = unstaged changes.
# (The extra untracked-files `git status` hook was dropped: it ran a second
# full status before every prompt and was the main source of prompt lag.)
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' formats " %F{cyan}%c%u(%b)%f"
zstyle ':vcs_info:*' actionformats " %F{cyan}%c%u(%b)%f %a"
zstyle ':vcs_info:*' stagedstr "%F{green}"
zstyle ':vcs_info:*' unstagedstr "%F{red}"
zstyle ':vcs_info:*' check-for-changes true

setopt PROMPT_SUBST
PROMPT='%n:%1~$vcs_info_msg_0_ %# '

# ========================================
# 🧰 Toolchains
# ========================================
# opam
[[ -r "$HOME/.opam/opam-init/init.zsh" ]] && source "$HOME/.opam/opam-init/init.zsh" >/dev/null 2>&1

alias ilab-start='ssh -MNf ilab'

# fnm
FNM_PATH="/opt/homebrew/opt/fnm/bin"
if [ -d "$FNM_PATH" ]; then
  eval "$(fnm env --shell zsh)"
fi

