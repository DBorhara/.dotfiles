# Shared git config (tracked in dotfiles).
# Identity lives in ~/.gitconfig.local, which is not committed.
[include]
	path = ~/.gitconfig.local

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true          # n / N jump between files in a diff
	line-numbers = true
	syntax-theme = Catppuccin Mocha
[diff]
	colorMoved = default
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[pull]
	rebase = false

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
